# GrowRoll client environment variables (Vite).
# Copy to `.env.local` for local overrides. On Vercel, set these in
# Project Settings -> Environment Variables (do NOT commit real .env).

# WebSocket URL of the relay server.
# - Local dev: leave unset (defaults to ws://localhost:8080)
# - Production: your TLS server, e.g. wss://growroll.example.com
VITE_SERVER_URL=ws://localhost:8080
